{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kotha-koi",
  "version": "1.0.0",
  "identifier": "com.kothakoi.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kotha-koi — English A1 → C2",
        "width": 1024,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Offline English A1-C2 learning",
    "longDescription": "kotha-koi - learn English from A1 to C2 completely offline: 119 units, 1,400+ practice questions, interview drill, text-to-speech, themes, and progress tracking."
  }
}
